    "graphql": "^17.0.2",
    "graphql-jit": "^0.8.9",
    "prettier": "^3.9.6",
    "process": "^0.11.10",
    "typescript": "^7.0.2",
    "util": "^0.12.5",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "lucide": "^1.45.0",
    "simple-icons": "^16.30.0"
