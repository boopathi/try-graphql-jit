    "codemirror-graphql": "^2.2.9",
    "graphql": "^17.0.2",
    "graphql-jit": "0.9.4",
    "prettier": "^3.9.10",
    "process": "^0.11.10",
    "typescript": "^7.0.2",
    "util": "^0.12.5",
    "vite": "8.3.3"
  },
  "dependencies": {
    "lucide": "1.47.0",
    "simple-icons": "^16.36.0"
  }
