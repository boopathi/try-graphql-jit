{
  "name": "try-graphql-jit",
  "version": "1.0.0",
  "private": true,
  "author": "boopathi",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "now-build": "pnpm build",
